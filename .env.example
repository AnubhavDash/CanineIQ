# CanineIQ Environment Variables
# This app runs the AI evaluation through the Vercel AI Gateway in a serverless
# function (api/evaluate.js). The key lives server-side only — never in the browser.

# Vercel AI Gateway key — create it in Vercel → project → Settings → AI Gateway.
# Used by api/evaluate.js to route to google/gemini-2.5-flash.
AI_GATEWAY_API_KEY=your_ai_gateway_key_here