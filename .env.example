# CanineIQ Environment Variables
# Copy this file to .env and fill in your keys

# ElevenLabs — for dog voice TTS on results page
REACT_APP_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Snowflake — for breed welfare data (wire into BreedHealth or a separate data service)
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=CANINEIQ
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Solana — for responsible ownership certificate minting
# REACT_APP_SOLANA_NETWORK=devnet
# REACT_APP_SOLANA_PROGRAM_ID=your_anchor_program_id
