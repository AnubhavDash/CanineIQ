# CanineIQ Environment Variables — copy to .env and fill in your keys
# Keys in .env are gitignored and never committed.

# Google Gemini — powers the readiness assessment & breed health analysis
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Set to true to call live APIs. Keep false (demo data) while reviewing UX/UI.
VITE_LIVE_MODE=false