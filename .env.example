# CanineIQ Environment Variables
# The AI evaluation runs server-side in the Vercel function api/evaluate.js.
# The key lives on the server only - never in the browser.

# Google Gemini API key (server-side only, read in api/evaluate.js and api/identify.js).
# Set this in Vercel: Settings > Environment Variables > GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key for the "Read it to me" feature (api/speech.js).
# Set this in Vercel: Settings > Environment Variables > ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ELEVENLABS_VOICE_ID overrides the default voice (designed voices only on free tier).
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9