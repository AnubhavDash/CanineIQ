# CanineIQ Environment Variables
# The AI evaluation runs server-side in the Vercel function api/evaluate.js.
# The key lives on the server only — never in the browser.

# Google Gemini API key (server-side only, read in api/evaluate.js).
# Set this in Vercel → Settings → Environment Variables → GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here